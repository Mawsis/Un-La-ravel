# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# The built binary at the repo root ONLY. A bare "unlaravel" would also match
# the cmd/unlaravel/ source directory and silently exclude the entrypoint from
# git — so this pattern is anchored to the root with a leading slash.
/unlaravel

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp

# Log files
*.log

# Test detector (temporary test file)
test_detector.go

# Build output
dist/
build/

# Playwright CLI debug output (from manual browser verification of web UI
# changes — never intentionally run from the repo root, but ignored as a
# backstop if it lands there)
.playwright-cli/