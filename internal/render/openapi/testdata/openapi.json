{
  "openapi": "3.0.3",
  "info": {
    "title": "Blog",
    "version": "11.9.0"
  },
  "paths": {
    "/posts": {
      "get": {
        "operationId": "PostController_index",
        "tags": [
          "PostController"
        ],
        "summary": "PostController@index",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "PostController_store",
        "tags": [
          "PostController"
        ],
        "summary": "PostController@store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "rule: unique"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "published"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "views": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  }
                },
                "required": [
                  "title",
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/posts/{post}": {
      "get": {
        "operationId": "PostController_show",
        "tags": [
          "PostController"
        ],
        "summary": "PostController@show",
        "parameters": [
          {
            "name": "post",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "operationId": "PostController_update",
        "tags": [
          "PostController"
        ],
        "summary": "PostController@update",
        "parameters": [
          {
            "name": "post",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "rule: unique"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "published"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "views": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  }
                },
                "required": [
                  "title",
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id?}": {
      "get": {
        "operationId": "users.show",
        "tags": [
          "UserController"
        ],
        "summary": "UserController@show",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}