METHOD  URI                   CONTROLLER@ACTION          MIDDLEWARE
GET     /posts                PostController@index       -
GET     /posts/{id}           PostController@show        -
POST    /posts                PostController@store       auth
GET     /legacy               PostController@show        -
POST    /webhooks             PostController@store       -
GET     /admin/users          UserController@index       auth:sanctum, throttle:api, tenant
GET     /admin/comments       CommentController@index    auth:sanctum, throttle:api, tenant
POST    /admin/comments       CommentController@store    auth:sanctum, throttle:api, tenant
GET     /admin/comments/{id}  CommentController@show     auth:sanctum, throttle:api, tenant
PUT     /admin/comments/{id}  CommentController@update   auth:sanctum, throttle:api, tenant
DELETE  /admin/comments/{id}  CommentController@destroy  auth:sanctum, throttle:api, tenant
DELETE  /admin/users/{id}     UserController@destroy     auth:sanctum, throttle:api, tenant  ⚠ DEAD
